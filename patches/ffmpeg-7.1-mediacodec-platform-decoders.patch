+static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
+{
+    MediaCodecH264DecContext *s = avctx->priv_data;
+
+    if (s->use_ndk_codec < 0)
+        s->use_ndk_codec = !av_jni_get_java_vm(avctx);
+
+#if CONFIG_AAC_MEDIACODEC_DECODER
+    /* ADTS AAC (for example MPEG-TS / HLS) arrives without extradata;
+     * aac_adtstoasc attaches the AudioSpecificConfig as packet side data
+     * on the first packet, so defer MediaCodec setup until then. */
+    if (avctx->codec_id == AV_CODEC_ID_AAC &&
+        (!avctx->extradata || !avctx->extradata_size)) {
+        return 0;
+    }
+#endif
+
+    return mediacodec_init_codec(avctx, avctx->extradata, avctx->extradata_size);
+}
